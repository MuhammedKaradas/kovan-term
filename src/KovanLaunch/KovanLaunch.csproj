<Project Sdk="Microsoft.NET.Sdk">

  <!-- Starts a terminal's program with its profile's environment variables; see Program.cs -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KovanLaunch</AssemblyName>
    <Product>Kovan Term</Product>
    <Version>0.1.0</Version>
    <DebugType>embedded</DebugType>
    <!-- It waits for the program for as long as the terminal runs: keep it small -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

</Project>
