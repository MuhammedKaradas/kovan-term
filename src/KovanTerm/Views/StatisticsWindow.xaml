<ui:FluentWindow x:Class="KovanTerm.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KovanTerm.ViewModels"
        xmlns:conv="clr-namespace:KovanTerm.Views.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:StatisticsViewModel}"
        Title="Statistics" Width="1080" Height="860" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.Resources>
        <conv:ScaleConverter x:Key="Scale"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- A card: a rounded panel on the window's background -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <!-- A project's color: its slot, or gray for the rest -->
        <Style x:Key="SlotDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource ChartOther}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Slot}" Value="1"><Setter Property="Fill" Value="{DynamicResource ChartSeries1}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="2"><Setter Property="Fill" Value="{DynamicResource ChartSeries2}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="3"><Setter Property="Fill" Value="{DynamicResource ChartSeries3}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="4"><Setter Property="Fill" Value="{DynamicResource ChartSeries4}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="5"><Setter Property="Fill" Value="{DynamicResource ChartSeries5}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="6"><Setter Property="Fill" Value="{DynamicResource ChartSeries6}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="7"><Setter Property="Fill" Value="{DynamicResource ChartSeries7}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SlotBar" TargetType="Border">
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="0,4,4,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ChartOther}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Slot}" Value="1"><Setter Property="Background" Value="{DynamicResource ChartSeries1}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="2"><Setter Property="Background" Value="{DynamicResource ChartSeries2}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="3"><Setter Property="Background" Value="{DynamicResource ChartSeries3}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="4"><Setter Property="Background" Value="{DynamicResource ChartSeries4}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="5"><Setter Property="Background" Value="{DynamicResource ChartSeries5}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="6"><Setter Property="Background" Value="{DynamicResource ChartSeries6}"/></DataTrigger>
                <DataTrigger Binding="{Binding Slot}" Value="7"><Setter Property="Background" Value="{DynamicResource ChartSeries7}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Period and metric buttons: the chosen one is highlighted -->
        <Style x:Key="Choice" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </ui:FluentWindow.Resources>

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Statistics" ShowMinimize="False"/>

        <!-- Period, refresh -->
        <DockPanel DockPanel.Dock="Top" Margin="20,4,20,10">
            <TextBlock DockPanel.Dock="Right" x:Name="ShareStatus" VerticalAlignment="Center" Margin="8,0" Style="{StaticResource Muted}"/>
            <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="10,3" Margin="6,0,0,0" FontSize="12" Click="Share_Click"
                       Content="Copy as image" ToolTip="Copy a picture of the numbers and the calendar, to paste in a chat or a post (also saved to Pictures)"
                       AutomationProperties.Name="Copy as image">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Image24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="8,3" Command="{Binding RefreshCommand}"
                       ToolTip="Read the conversations again (F5)" AutomationProperties.Name="Refresh statistics">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise20"/></ui:Button.Icon>
            </ui:Button>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="7 days" Command="{Binding ShowPeriodCommand}" CommandParameter="{x:Static vm:StatsPeriod.Week}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource Choice}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Period}" Value="Week"><Setter Property="Appearance" Value="Primary"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="30 days" Command="{Binding ShowPeriodCommand}" CommandParameter="{x:Static vm:StatsPeriod.Month}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource Choice}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Period}" Value="Month"><Setter Property="Appearance" Value="Primary"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="12 months" Command="{Binding ShowPeriodCommand}" CommandParameter="{x:Static vm:StatsPeriod.Year}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource Choice}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Period}" Value="Year"><Setter Property="Appearance" Value="Primary"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <TextBlock Text="{Binding PeriodText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="  ·  click a day on the calendar to see it" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <!-- While reading -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36"/>
                <TextBlock Text="{Binding LoadingText}" Margin="0,12,0,0" Style="{StaticResource Muted}" AutomationProperties.Name="Loading"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,8">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <TextBlock Text="No Claude Code or Codex conversations were found on this computer." Margin="0,0,0,12" Style="{StaticResource Muted}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- What "Copy as image" pictures: the period, its numbers and the calendar -->
                    <StackPanel x:Name="ShareArea">
                    <TextBlock x:Name="ShareTitle" Visibility="Collapsed" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <!-- Headline numbers for the period -->
                    <UniformGrid Rows="1" Margin="0,0,0,12">
                        <UniformGrid.Resources>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </UniformGrid.Resources>
                        <Border AutomationProperties.Name="Active time">
                            <StackPanel>
                                <TextBlock Text="Active time" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding ActiveTime}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="Active days" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding ActiveDays}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="Projects" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding ProjectCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="Sessions" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding SessionCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border ToolTip="{Binding TokenDetail}">
                            <StackPanel>
                                <TextBlock Text="Tokens" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding TokenCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0" ToolTip="Commits by you (the repository's git user) in the projects the conversations ran in, all branches">
                            <StackPanel>
                                <TextBlock Text="Commits" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding CommitCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           AutomationProperties.Name="Commit count"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Text="{Binding TokenDetail}" Style="{StaticResource Muted}" Margin="2,-6,0,12"/>

                    <!-- A year of days -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <ui:Button Content="Time" Command="{Binding ShowMetricCommand}" CommandParameter="{x:Static vm:StatsMetric.Time}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource Choice}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Metric}" Value="Time"><Setter Property="Appearance" Value="Primary"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                    <ui:Button Content="Tokens" Command="{Binding ShowMetricCommand}" CommandParameter="{x:Static vm:StatsMetric.Tokens}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource Choice}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Metric}" Value="Tokens"><Setter Property="Appearance" Value="Primary"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Activity" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <TextBlock Text="{Binding CalendarSummary}" Style="{StaticResource Muted}" Margin="0,2,0,10"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <!-- Weekday names -->
                                <StackPanel Margin="0,16,6,0">
                                    <StackPanel.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Height" Value="15"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="Mon"/><TextBlock Text=""/><TextBlock Text="Wed"/><TextBlock Text=""/><TextBlock Text="Fri"/>
                                </StackPanel>
                                <StackPanel>
                                    <!-- Month names over their first week -->
                                    <ItemsControl ItemsSource="{Binding Weeks}" Height="16">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CalendarWeek}">
                                                <Canvas Width="15">
                                                    <TextBlock Text="{Binding Month}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Weeks}" AutomationProperties.Name="Activity calendar">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CalendarWeek}">
                                                <ItemsControl ItemsSource="{Binding Days}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:CalendarDay}">
                                                            <Button Width="15" Height="15" Cursor="Hand" ToolTip="{Binding Tooltip}" Focusable="False"
                                                                    AutomationProperties.Name="{Binding Tooltip}"
                                                                    Command="{Binding DataContext.ShowDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Date}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <!-- The hit target is the whole 15 px slot; the mark is 12 px with a 3 px gap -->
                                                                        <Border Background="Transparent">
                                                                            <Border x:Name="Cell" Width="12" Height="12" CornerRadius="2" BorderThickness="0"
                                                                                    Background="{DynamicResource ChartLevel0}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding Level}" Value="1"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource ChartLevel1}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="2"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource ChartLevel2}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="3"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource ChartLevel3}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="4"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource ChartLevel4}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsFuture}" Value="True"><Setter TargetName="Cell" Property="Background" Value="Transparent"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                                <Setter TargetName="Cell" Property="BorderThickness" Value="2"/>
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                                <Setter TargetName="Cell" Property="BorderThickness" Value="1"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                            <!-- Legend -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="Width" Value="12"/>
                                        <Setter Property="Height" Value="12"/>
                                        <Setter Property="CornerRadius" Value="2"/>
                                        <Setter Property="Margin" Value="3,0,0,0"/>
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock Text="Less" Style="{StaticResource Muted}" Margin="0,0,4,0"/>
                                <Border Background="{DynamicResource ChartLevel0}"/>
                                <Border Background="{DynamicResource ChartLevel1}"/>
                                <Border Background="{DynamicResource ChartLevel2}"/>
                                <Border Background="{DynamicResource ChartLevel3}"/>
                                <Border Background="{DynamicResource ChartLevel4}"/>
                                <TextBlock Text="More" Style="{StaticResource Muted}" Margin="7,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <!-- Hours a day, and models -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Hours a day" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding Days}" AutomationProperties.Name="Hours a day">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DayBar}">
                                            <Button Cursor="Hand" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}" Focusable="False"
                                                    Command="{Binding DataContext.ShowDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Date}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Background="Transparent">
                                                            <Grid Height="110">
                                                                <!-- Rounded at the data end, square at the baseline -->
                                                                <Border x:Name="Bar" Width="16" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                                                        Height="{Binding Fraction, Converter={StaticResource Scale}, ConverterParameter=110}"
                                                                        Background="{DynamicResource ChartBar}" Opacity="0.85"/>
                                                            </Grid>
                                                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                            <TextBlock x:Name="Label" Text="{Binding Label}" TextAlignment="Center" FontSize="10" Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                                                <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tokens by model" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding Models}" AutomationProperties.Name="Tokens by model" Grid.IsSharedSizeScope="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ModelRow}">
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Model"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Model}" FontSize="12" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Border Grid.Column="1" Height="8" CornerRadius="0,4,4,0" HorizontalAlignment="Left" Background="{DynamicResource ChartBar}"
                                                        Width="{Binding Fraction, Converter={StaticResource Scale}, ConverterParameter=120}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TokensText}" FontSize="12" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Projects in the period: a table, with bars -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <TextBlock Text="Projects" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Project" Style="{StaticResource Muted}"/>
                                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="Time" Style="{StaticResource Muted}"/>
                                <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Text="Tokens" Style="{StaticResource Muted}"/>
                                <TextBlock Grid.Column="5" Text="Sessions" Style="{StaticResource Muted}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="Commits" Style="{StaticResource Muted}" TextAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Projects}" AutomationProperties.Name="Projects">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProjectRow}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                <Ellipse Style="{StaticResource SlotDot}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" x:Name="TimeTrack">
                                                <Border Style="{StaticResource SlotBar}" Width="{Binding TimeFraction, Converter={StaticResource Scale}, ConverterParameter=220}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Grid Grid.Column="3">
                                                <Border Style="{StaticResource SlotBar}" Opacity="0.6" Width="{Binding TokensFraction, Converter={StaticResource Scale}, ConverterParameter=220}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="4" Text="{Binding TokensText}" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Sessions}" FontSize="12" TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Commits}" FontSize="12" TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Commits in the period -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Commits" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="None in this period.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Commits.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Commits}" AutomationProperties.Name="Commits">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CommitRow}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding When}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Ellipse Grid.Column="1" Style="{StaticResource SlotDot}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Project}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Subject}" Margin="8,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding Subject}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Each session in the period -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sessions" Style="{StaticResource CardTitle}"/>
                            <ItemsControl ItemsSource="{Binding Log}" AutomationProperties.Name="Sessions">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SessionRow}">
                                        <Expander Margin="0,2" Padding="28,4,8,6" AutomationProperties.Name="{Binding Title}">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding When}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Ellipse Grid.Column="1" Style="{StaticResource SlotDot}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                        <Run Text="{Binding Project, Mode=OneWay}"/><Run Text="{Binding Agent, StringFormat='  {0}', Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="8,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding Title}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Duration}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Tokens}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Grid>
                                            </Expander.Header>
                                            <!-- What was asked -->
                                            <ItemsControl ItemsSource="{Binding Prompts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
