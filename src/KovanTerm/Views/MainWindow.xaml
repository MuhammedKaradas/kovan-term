<Window x:Class="KovanTerm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        xmlns:vm="clr-namespace:KovanTerm.ViewModels"
        xmlns:conv="clr-namespace:KovanTerm.Views.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Kovan Term" Height="900" Width="1500"
        Background="#16171d">
    <Window.Resources>
        <conv:NodeStatusToBrushConverter x:Key="StatusToBrush"/>
    </Window.Resources>

    <DockPanel>
        <!-- Üst çubuk -->
        <Border DockPanel.Dock="Top" Background="#1f2029" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding QuickLaunches}" Margin="0,0,8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" ContentStringFormat="+ {0}" Margin="0,0,8,0" Padding="10,4"
                                    Command="{Binding DataContext.AddTerminalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Foreground="#9aa0b4" VerticalAlignment="Center" FontFamily="Consolas">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Uygulama RAM: {0} MB   |   Terminal: {1}   |   Zoom: {2:0.00}">
                            <Binding Path="MemoryMb"/>
                            <Binding Path="Nodes.Count"/>
                            <Binding Path="ViewportZoom"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>

        <nodify:NodifyEditor x:Name="Editor"
                             ItemsSource="{Binding Nodes}"
                             ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                             ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                             Background="#16171d"
                             MinViewportZoom="0.3" MaxViewportZoom="1.5">
            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="{x:Type nodify:ItemContainer}">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}"/>
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TerminalNodeViewModel}">
                    <Border Background="#22232d" BorderBrush="#3a3c4a" BorderThickness="1" CornerRadius="8">
                        <DockPanel>
                            <!-- Başlık: buradan sürüklenir -->
                            <Border DockPanel.Dock="Top" Background="#2a2c38" CornerRadius="8,8,0,0" Padding="10,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕"
                                            Command="{Binding DataContext.CloseNodeCommand, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Foreground="#9aa0b4" Padding="6,0"/>
                                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#e6e8f0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <!-- Hareket sırasında canlı terminal yerine anlık görüntüsü gösterilir (TerminalCanvasController) -->
                            <Grid Width="{Binding Width}" Height="{Binding Height}">
                                <Image Visibility="Collapsed" Stretch="Fill"/>
                                <term:EasyTerminalControl StartupCommandLine="{Binding CommandLine}"
                                                          WorkingDirectory="{Binding WorkingDirectory}"
                                                          FontSizeWhenSettingTheme="13"
                                                          Loaded="Terminal_Loaded"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>
        </nodify:NodifyEditor>
    </DockPanel>
</Window>
