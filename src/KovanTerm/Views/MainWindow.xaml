<Window x:Class="KovanTerm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        xmlns:vm="clr-namespace:KovanTerm.ViewModels"
        xmlns:conv="clr-namespace:KovanTerm.Views.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Kovan Term" Height="900" Width="1500"
        Background="#16171d">
    <Window.Resources>
        <conv:NodeStatusToBrushConverter x:Key="StatusToBrush"/>

        <!-- Node body: live terminal. During motion its snapshot is shown instead (TerminalCanvasController) -->
        <DataTemplate x:Key="TerminalBody" DataType="{x:Type vm:TerminalNodeViewModel}">
            <Grid>
                <Image Visibility="Collapsed" Stretch="Fill"/>
                <term:EasyTerminalControl StartupCommandLine="{Binding CommandLine}"
                                          WorkingDirectory="{Binding WorkingDirectory}"
                                          FontSizeWhenSettingTheme="13"
                                          Loaded="Terminal_Loaded"/>
            </Grid>
        </DataTemplate>

        <!-- Node body: terminal couldn't start (e.g. command not found); no terminal is created -->
        <DataTemplate x:Key="ErrorBody" DataType="{x:Type vm:TerminalNodeViewModel}">
            <Border Background="#0c0c0c" Padding="16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Couldn't start terminal" Foreground="#e5a04b" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding StartError}" Foreground="#c8cbd6" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="#1f2029" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ New terminal" Command="{Binding NewTerminalCommand}" Margin="0,0,16,0" Padding="10,4"
                        ToolTip="Open a new terminal with a chosen profile and working directory (Ctrl+Shift+T). Right-click the canvas: open it where you clicked."/>
                <TextBlock Foreground="#9aa0b4" VerticalAlignment="Center" FontFamily="Consolas">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="App RAM: {0} MB   |   Terminals: {1}   |   Zoom: {2:0.00}">
                            <Binding Path="MemoryMb"/>
                            <Binding Path="Nodes.Count"/>
                            <Binding Path="ViewportZoom"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>

        <nodify:NodifyEditor x:Name="Editor"
                             ItemsSource="{Binding Nodes}"
                             ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                             ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                             Background="#16171d"
                             MinViewportZoom="0.3" MaxViewportZoom="1.5"
                             ContextMenuOpening="Editor_ContextMenuOpening">
            <nodify:NodifyEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New terminal here…" Click="NewTerminalHere_Click"/>
                </ContextMenu>
            </nodify:NodifyEditor.ContextMenu>
            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="{x:Type nodify:ItemContainer}">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}"/>
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TerminalNodeViewModel}">
                    <Border Background="#22232d" BorderBrush="#3a3c4a" BorderThickness="1" CornerRadius="8">
                        <DockPanel>
                            <!-- Header: drag from here -->
                            <Border DockPanel.Dock="Top" Background="#2a2c38" CornerRadius="8,8,0,0" Padding="10,6"
                                    MouseLeftButtonDown="NodeHeader_MouseLeftButtonDown" ToolTip="Double-click: zoom to this terminal">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕"
                                            Command="{Binding DataContext.CloseNodeCommand, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Foreground="#9aa0b4" Padding="6,0"/>
                                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#e6e8f0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <!-- Profile color -->
                            <Border DockPanel.Dock="Top" Height="2" Background="{Binding Color}"/>
                            <!-- Resize strip: below the terminal, since WPF can't draw on top of it (airspace) -->
                            <Grid DockPanel.Dock="Bottom" Height="10">
                                <Thumb HorizontalAlignment="Right" Width="28" Cursor="SizeNWSE" ToolTip="Resize"
                                       DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent">
                                                <Path Data="M 4,8 L 12,0 M 12,8 L 20,0 M 20,8 L 26,2" Stroke="#6b6f80" StrokeThickness="1.2"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <ContentControl Content="{Binding}" Width="{Binding Width}" Height="{Binding Height}" Focusable="False">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TerminalBody}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStartError}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ErrorBody}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>
        </nodify:NodifyEditor>
    </DockPanel>
</Window>
