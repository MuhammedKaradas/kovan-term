<ui:FluentWindow x:Class="KovanTerm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:KovanTerm.ViewModels"
        xmlns:models="clr-namespace:KovanTerm.Models"
        xmlns:conv="clr-namespace:KovanTerm.Views.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Kovan Term" Height="900" Width="1500"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <conv:NodeStatusToBrushConverter x:Key="StatusToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:PercentToFractionConverter x:Key="PercentToFraction"/>

        <!-- A text line that disappears when it has nothing to say -->
        <Style x:Key="HideWhenNull" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BoardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>

        <!-- Right panel tabs: flat text buttons with an underline for the selected one -->
        <Style x:Key="PanelTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tab" Padding="10,6" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A task card on the Board -->
        <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type vm:TaskCard}">
            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Appearance="Transparent" Padding="4" Width="26" Height="24" ToolTip="Start (in progress)"
                                       AutomationProperties.Name="Start task" Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}"
                                       Command="{Binding DataContext.StartTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                       CommandParameter="{Binding}">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="Play16"/></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Padding="4" Width="26" Height="24" ToolTip="Done"
                                       AutomationProperties.Name="Finish task" Visibility="{Binding CanFinish, Converter={StaticResource BoolToVisibility}}"
                                       Command="{Binding DataContext.FinishTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                       CommandParameter="{Binding}">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="Checkmark16"/></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Padding="4" Width="26" Height="24" ToolTip="Back to To do"
                                       AutomationProperties.Name="Reopen task" Visibility="{Binding CanReopen, Converter={StaticResource BoolToVisibility}}"
                                       Command="{Binding DataContext.ReopenTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                       CommandParameter="{Binding}">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUndo16"/></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Padding="4" Width="26" Height="24" ToolTip="Delete"
                                       AutomationProperties.Name="Delete task"
                                       Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                       CommandParameter="{Binding}">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss16"/></ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{StaticResource HideWhenNull}"/>
                    <TextBlock Text="{Binding Owner}" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Style="{StaticResource HideWhenNull}"/>
                    <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Style="{StaticResource HideWhenNull}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Board tab: the agents' task board, their messages and leased files -->
        <DataTemplate x:Key="BoardView" DataType="{x:Type vm:BoardViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8,12,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <ui:Button DockPanel.Dock="Right" Content="Add" Margin="6,0,0,0" Command="{Binding AddTaskCommand}"/>
                        <ui:TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="New task for the agents"
                                    AutomationProperties.Name="New task" KeyDown="NewTask_KeyDown"/>
                    </DockPanel>

                    <TextBlock Text="In progress" Style="{StaticResource BoardHeader}"/>
                    <ItemsControl ItemsSource="{Binding Doing}" ItemTemplate="{StaticResource TaskCardTemplate}"/>
                    <TextBlock Text="To do" Style="{StaticResource BoardHeader}"/>
                    <ItemsControl ItemsSource="{Binding Todo}" ItemTemplate="{StaticResource TaskCardTemplate}"/>
                    <TextBlock Text="Done" Style="{StaticResource BoardHeader}"/>
                    <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource TaskCardTemplate}"/>

                    <StackPanel Visibility="{Binding HasLeases, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Leased files" Style="{StaticResource BoardHeader}"/>
                        <ItemsControl ItemsSource="{Binding Leases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="Messages between agents" Style="{StaticResource BoardHeader}"/>
                    <TextBlock Text="None yet. Agents send them with the kovan tools; you see every one here." FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMessages}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MessageLine}">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Header}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <!-- Branch label: only for nodes working in a worktree -->
        <Style x:Key="BranchVisibility" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding BranchText}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Node body: live terminal. During motion its snapshot is shown instead (TerminalCanvasController) -->
        <DataTemplate x:Key="TerminalBody" DataType="{x:Type vm:TerminalNodeViewModel}">
            <Grid>
                <Image Visibility="Collapsed" Stretch="Fill"/>
                <term:EasyTerminalControl StartupCommandLine="{Binding StartupCommandLine}"
                                          WorkingDirectory="{Binding WorkingDirectory}"
                                          FontSizeWhenSettingTheme="13"
                                          Loaded="Terminal_Loaded"/>
            </Grid>
        </DataTemplate>

        <!-- Node body: terminal couldn't start (e.g. command not found); no terminal is created -->
        <!-- Node body: web preview. The WebView2 is an HWND like a terminal: during motion its snapshot is shown
             (TerminalCanvasController), and the page is zoomed like the canvas -->
        <DataTemplate x:Key="PreviewBody" DataType="{x:Type vm:TerminalNodeViewModel}">
            <DockPanel Background="{DynamicResource TerminalBackgroundBrush}">
                <DockPanel DockPanel.Dock="Top" Margin="4,4,4,4">
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Width="28" Height="28" Padding="0" ToolTip="Open in your browser"
                               AutomationProperties.Name="Open in browser" Click="PreviewOpenExternal_Click">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Open16"/></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Width="28" Height="28" Padding="0" ToolTip="Reload"
                               AutomationProperties.Name="Reload preview" Click="PreviewReload_Click">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise16"/></ui:Button.Icon>
                    </ui:Button>
                    <ui:TextBox Text="{Binding Url, UpdateSourceTrigger=Explicit}" FontSize="12" Padding="8,3" MinHeight="28"
                                AutomationProperties.Name="Address" KeyDown="PreviewAddress_KeyDown" ClearButtonEnabled="False"/>
                </DockPanel>
                <Grid>
                    <Image Visibility="Collapsed" Stretch="Fill"/>
                    <Border Loaded="Preview_Loaded">
                        <wv2:WebView2 DefaultBackgroundColor="White"/>
                    </Border>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ErrorBody" DataType="{x:Type vm:TerminalNodeViewModel}">
            <Border Background="{DynamicResource TerminalBackgroundBrush}" Padding="16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Couldn't start terminal" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding StartError}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Kovan Term">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Grid24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="12,0,12,8" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left" Appearance="Transparent" Margin="0,0,8,0" Command="{Binding ToggleAgentsPanelCommand}"
                       ToolTip="Show/hide the Agents panel (Ctrl+Shift+A)" AutomationProperties.Name="Toggle Agents panel">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="PanelLeft24"/>
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button DockPanel.Dock="Left" Appearance="Primary" Content="New terminal" Command="{Binding NewTerminalCommand}"
                       ToolTip="Open a new terminal with a chosen profile and working directory (Ctrl+Shift+T). Right-click the canvas: open it where you clicked.">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24"/>
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Command="{Binding ToggleBoardCommand}" Margin="8,0,0,0"
                       ToolTip="The agents' task board and messages (Ctrl+Shift+B)" AutomationProperties.Name="Toggle Board">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="TaskListSquareLtr24"/>
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Command="{Binding ToggleChangesPanelCommand}" Margin="8,0,0,0"
                       ToolTip="Show/hide the Changes panel (Ctrl+Shift+G)" AutomationProperties.Name="Toggle Changes panel">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="PanelRight24"/>
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Command="{Binding CycleThemeCommand}" Margin="8,0,0,0"
                       AutomationProperties.Name="Change theme">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="ToolTip" Value="Theme: follows Windows (click to change)"/>
                        <Setter Property="Icon">
                            <Setter.Value>
                                <ui:SymbolIcon Symbol="DarkTheme24"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Theme}" Value="{x:Static models:ThemePreference.Dark}">
                                <Setter Property="ToolTip" Value="Theme: dark (click to change)"/>
                                <Setter Property="Icon">
                                    <Setter.Value>
                                        <ui:SymbolIcon Symbol="WeatherMoon24"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Theme}" Value="{x:Static models:ThemePreference.Light}">
                                <Setter Property="ToolTip" Value="Theme: light (click to change)"/>
                                <Setter Property="Icon">
                                    <Setter.Value>
                                        <ui:SymbolIcon Symbol="WeatherSunny24"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>

            <ui:Button DockPanel.Dock="Left" Appearance="Secondary" Content="Recent" Margin="8,0,0,0" Command="{Binding OpenRecentConversationCommand}"
                       ToolTip="Reopen a recent Claude Code conversation (Ctrl+Shift+O)" AutomationProperties.Name="Recent conversations">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="History24"/>
                </ui:Button.Icon>
            </ui:Button>

            <!-- Agents waiting for the user: each click goes to the next one -->
            <ui:Button DockPanel.Dock="Left" Margin="8,0,0,0" Appearance="Caution" Command="{Binding GoToWaitingCommand}"
                       ToolTip="Go to the next agent waiting for you" AutomationProperties.Name="Go to waiting agent">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WaitingCount}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="AlertUrgent24"/>
                </ui:Button.Icon>
                <TextBlock Text="{Binding WaitingCount, StringFormat={}{0} waiting}"/>
            </ui:Button>

            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{3} working  ·  {1} terminals  ·  {0} MB  ·  {2:P0}">
                        <Binding Path="MemoryMb"/>
                        <Binding Path="Nodes.Count"/>
                        <Binding Path="ViewportZoom"/>
                        <Binding Path="WorkingCount"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DockPanel>

        <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Changes panel: git changes of the current terminal's folder. Same rules as the Agents panel: beside the
             canvas, square, flush with the window edge. -->
        <Border Grid.Column="2" Width="460" BorderThickness="1,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Visibility="{Binding ShowChangesPanel, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
            <!-- Tabs: Changes | Board -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,8,0">
                <RadioButton Content="Changes" GroupName="RightPanel" Style="{StaticResource PanelTab}" AutomationProperties.Name="Changes tab"
                             IsChecked="{Binding IsChangesTab, Mode=TwoWay}"/>
                <RadioButton GroupName="RightPanel" Style="{StaticResource PanelTab}" AutomationProperties.Name="Board tab"
                             IsChecked="{Binding IsBoardTab, Mode=TwoWay}">
                    <TextBlock>
                        <Run Text="Board"/><Run Text="{Binding BoardPanel.Badge, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </TextBlock>
                </RadioButton>
            </StackPanel>

            <ContentControl DataContext="{Binding BoardPanel}" Content="{Binding}" ContentTemplate="{StaticResource BoardView}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Visibility="{Binding DataContext.IsBoardTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>

            <Grid DataContext="{Binding Changes}"
                  Visibility="{Binding DataContext.IsChangesTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: which terminal, refresh -->
                <DockPanel Grid.Row="0" Margin="12,8,8,4">
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Width="30" Height="30" Padding="0"
                               Command="{Binding RefreshCommand}" ToolTip="Refresh" AutomationProperties.Name="Refresh changes">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise20"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <StackPanel>
                        <TextBlock Text="Changes" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding Node.WorkingDirectory}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" ToolTip="{Binding Node.WorkingDirectory}"/>
                        <!-- Worktree actions: get the agent's work back -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Node.Worktree}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:Button Appearance="Secondary" Height="26" Padding="10,0" FontSize="12" Margin="0,0,6,0"
                                       Content="{Binding Node.MergeLabel}"
                                       ToolTip="Merge this branch into the branch it started from, in the main checkout"
                                       AutomationProperties.Name="Merge worktree"
                                       Command="{Binding DataContext.MergeWorktreeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding Node}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="BranchFork16"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" Height="26" Padding="10,0" FontSize="12" Content="Pull request"
                                       ToolTip="Push this branch and open the page to create a pull request"
                                       AutomationProperties.Name="Pull request"
                                       Command="{Binding DataContext.CreatePullRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding Node}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowUpload16"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                        <TextBlock Text="{Binding Node.BranchText, StringFormat=Branch {0} · since it started}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   ToolTip="Committed and uncommitted work on this branch, compared with the commit it started from">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Node.BranchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Changed files -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" MaxHeight="200"
                         Background="Transparent" BorderThickness="0" Margin="4,0,4,4" AutomationProperties.Name="Changed files"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Path}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Padding="8,3" CornerRadius="4" Background="Transparent" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Code}" Width="16" FontFamily="Cascadia Mono, Consolas"
                                           FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Folder}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Diff (virtualized: generated files can be long). Click a line to leave a note. -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding DiffLines}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Diff">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MouseLeftButtonUp="DiffLine_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                        <Setter Property="Background" Value="#332EA043"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                        <Setter Property="Background" Value="#33F85149"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Hunk">
                                                        <Setter Property="Background" Value="#1A388BFD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding OldLine}" Width="38" TextAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding NewLine}" Width="38" TextAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding Marker}" Width="18" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Padding="0,0,12,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Message}" Margin="16" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>

                <!-- Note being written for a line -->
                <Border Grid.Row="3" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Visibility="{Binding IsEditingNote, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                            <Run Text="Note on line"/>
                            <Run Text="{Binding NoteLine.Line, Mode=OneWay}"/><Run Text=":"/>
                            <Run Text="{Binding NoteLine.Text, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"/>
                        </TextBlock>
                        <ui:TextBox x:Name="NoteBox" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,6"
                                    PlaceholderText="What should the agent change here?" AcceptsReturn="False" KeyDown="NoteBox_KeyDown"
                                    AutomationProperties.Name="Note"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Cancel" Appearance="Secondary" Command="{Binding CancelNoteCommand}" Margin="0,0,6,0"/>
                            <ui:Button Content="Add note" Appearance="Primary" Command="{Binding AddNoteCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notes waiting to be sent -->
                <Border Grid.Row="4" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Notes}" MaxHeight="140">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Width="24" Height="24" Padding="0"
                                                   ToolTip="Remove note" AutomationProperties.Name="Remove note"
                                                   Command="{Binding DataContext.RemoveNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Dismiss16"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text}">
                                            <Run Text="{Binding Location, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <Run Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Content="{Binding SendNotesLabel}" Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                   Command="{Binding SendNotesCommand}"
                                   ToolTip="Pastes the notes into the terminal's prompt as one message; press Enter there to send"/>
                    </StackPanel>
                </Border>
            </Grid>
            </DockPanel>
        </Border>

        <!-- Agents panel: beside the canvas, never over it (terminals are HWNDs; nothing can be drawn on top).
             Square and flush with the window on purpose: a large rounded, bordered panel here dropped canvas
             motion from ~59 to ~34 fps (KOVAN_PERF_SELFTEST, 10 terminals). -->
        <Border Grid.Column="0" Width="280" BorderThickness="0,1,1,0"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Visibility="{Binding ShowAgentsPanel, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Agents" FontWeight="SemiBold" Margin="12,10,12,6"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- Claude plan limits; hidden when unknown (not logged in, endpoint changed) -->
                <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Padding="12,8,12,10" Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Claude plan" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding UsageRows}" AutomationProperties.Name="Claude plan usage" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UsageRow}">
                                    <Grid Margin="0,3" ToolTip="{Binding ResetsAtText, StringFormat=Resets {0}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="UsageLabel"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1">
                                            <!-- A plain bar: no animation, nothing redrawn while the canvas moves -->
                                            <Grid Height="4">
                                                <Rectangle Fill="{DynamicResource ControlStrokeColorDefaultBrush}" RadiusX="2" RadiusY="2"/>
                                                <Rectangle RadiusX="2" RadiusY="2" RenderTransformOrigin="0,0.5">
                                                    <Rectangle.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Percent, Converter={StaticResource PercentToFraction}}"/>
                                                    </Rectangle.RenderTransform>
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                            </Grid>
                                            <TextBlock Text="{Binding Text}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- An ItemsControl, not a ListBox: rows aren't "selected", a click goes to the node -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="4,0,4,8">
                <ItemsControl x:Name="AgentsList" AutomationProperties.Name="Agents">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="8,10,8,2" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TerminalNodeViewModel}">
                            <Border BorderThickness="2,0,0,0" Padding="8,6" Margin="0,1" CornerRadius="4" Cursor="Hand"
                                    MouseLeftButtonUp="AgentRow_Click" AutomationProperties.Name="{Binding Title}"
                                    ToolTip="Go to this terminal">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:NodeStatus.Waiting}">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ContextText}" FontSize="11" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   ToolTip="Context the conversation uses (input of the latest reply)"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="16,1,0,0" Style="{StaticResource BranchVisibility}">
                                        <ui:SymbolIcon Symbol="Branch16" FontSize="11" Margin="0,0,3,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{Binding BranchText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" Margin="16,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SubagentsText}" Margin="16,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" ToolTip="{Binding SubagentsText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SubagentsText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="16,6,0,0"
                                                Visibility="{Binding AwaitsPermission, Converter={StaticResource BoolToVisibility}}">
                                        <ui:Button Content="Allow" Appearance="Success" Height="24" Padding="10,0" FontSize="12" Margin="0,0,4,0"
                                                   AutomationProperties.Name="{Binding Title, StringFormat=Allow {0}}"
                                                   Command="{Binding DataContext.AllowPermissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"/>
                                        <ui:Button Content="Deny" Appearance="Secondary" Height="24" Padding="10,0" FontSize="12"
                                                   AutomationProperties.Name="{Binding Title, StringFormat=Deny {0}}"
                                                   Command="{Binding DataContext.DenyPermissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Transparent canvas: the Mica backdrop shows through -->
        <nodify:NodifyEditor x:Name="Editor" Grid.Column="1"
                             ItemsSource="{Binding Nodes}"
                             ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                             ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                             Background="Transparent"
                             MinViewportZoom="0.3" MaxViewportZoom="1.5"
                             ContextMenuOpening="Editor_ContextMenuOpening">
            <nodify:NodifyEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New terminal here…" Click="NewTerminalHere_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Add24"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open a recent conversation here…" Click="RecentConversationHere_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="History24"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="New web preview here" Click="NewPreviewHere_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Globe24"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </nodify:NodifyEditor.ContextMenu>
            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="{x:Type nodify:ItemContainer}">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}"/>
                    <!-- Nodify's own square border would double up with the node's rounded one; selection is shown on the node instead -->
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="HighlightBrush" Value="Transparent"/>
                    <Setter Property="SelectedBrush" Value="Transparent"/>
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TerminalNodeViewModel}">
                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderThickness="1" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=nodify:ItemContainer}}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    </DataTrigger>
                                    <!-- Waiting for the user wins over selection. Only the color changes: a thicker border
                                         would shrink the terminal and make it reflow. -->
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:NodeStatus.Waiting}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <!-- Header: drag from here -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                                    CornerRadius="8,8,0,0" Padding="10,0,4,0" Height="32"
                                    MouseLeftButtonDown="NodeHeader_MouseLeftButtonDown" ToolTip="Double-click: zoom to this terminal">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Width="26" Height="26" Padding="0"
                                               ToolTip="Close terminal" AutomationProperties.Name="Close terminal"
                                               Command="{Binding DataContext.CloseNodeCommand, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                                               CommandParameter="{Binding}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Dismiss16"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <!-- The terminal printed a local web address (a dev server): preview it next to the terminal -->
                                    <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Height="24" Padding="8,0" FontSize="12" Margin="0,0,6,0"
                                               Content="Preview" ToolTip="{Binding PreviewUrl}" AutomationProperties.Name="Preview"
                                               Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                                               CommandParameter="{Binding}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewUrl}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Globe16"/></ui:Button.Icon>
                                    </ui:Button>
                                    <!-- Answers the agent's permission prompt without clicking into the terminal -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,6,0"
                                                Visibility="{Binding AwaitsPermission, Converter={StaticResource BoolToVisibility}}">
                                        <ui:Button Content="Allow" Appearance="Success" Height="24" Padding="10,0" FontSize="12" Margin="0,0,4,0"
                                                   ToolTip="Answer the permission prompt with Yes (once)"
                                                   Command="{Binding DataContext.AllowPermissionCommand, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                                                   CommandParameter="{Binding}"/>
                                        <ui:Button Content="Deny" Appearance="Secondary" Height="24" Padding="10,0" FontSize="12"
                                                   ToolTip="Answer No; then tell the agent what to do instead"
                                                   Command="{Binding DataContext.DenyPermissionCommand, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                                                   CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                                ToolTip="{Binding Worktree.Path, StringFormat=Worktree: {0}}" Style="{StaticResource BranchVisibility}">
                                        <ui:SymbolIcon Symbol="Branch16" FontSize="12" Margin="0,0,3,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{Binding BranchText}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                            <!-- Profile color -->
                            <Border DockPanel.Dock="Top" Height="2" Background="{Binding Color}"/>
                            <!-- Resize strip: below the terminal, since WPF can't draw on top of it (airspace) -->
                            <Grid DockPanel.Dock="Bottom" Height="10">
                                <Thumb HorizontalAlignment="Right" Width="28" Cursor="SizeNWSE" ToolTip="Resize"
                                       DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent">
                                                <Path Data="M 4,8 L 12,0 M 12,8 L 20,0 M 20,8 L 26,2" Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                                                      StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <ContentControl Content="{Binding}" Width="{Binding Width}" Height="{Binding Height}" Focusable="False">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TerminalBody}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStartError}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ErrorBody}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBrowser}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource PreviewBody}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>
        </nodify:NodifyEditor>
        </Grid>
    </Grid>
</ui:FluentWindow>
