<ui:FluentWindow x:Class="KovanTerm.Views.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KovanTerm.ViewModels"
        xmlns:services="clr-namespace:KovanTerm.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ToolsViewModel}"
        Title="Tools" Width="820" Height="760" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}"/>
        <KeyBinding Key="F5" Command="{Binding LoadCommand}"/>
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </ui:FluentWindow.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Tools" ShowMinimize="False"/>

        <!-- Agent, filter, refresh -->
        <StackPanel DockPanel.Dock="Top" Margin="20,4,20,10">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Width="32" Height="32" Padding="0" Margin="8,0,0,0"
                           Command="{Binding LoadCommand}" ToolTip="Read again (F5)" AutomationProperties.Name="Refresh tools">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise20"/></ui:Button.Icon>
                </ui:Button>
                <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Agents}" SelectedItem="{Binding Agent}" MinWidth="150" Margin="0,0,8,0"
                          AutomationProperties.Name="Agent"/>
                <ui:TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, description or source"
                            AutomationProperties.Name="Filter tools"/>
            </DockPanel>
            <TextBlock Text="{Binding ProjectText}" Style="{StaticResource Muted}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ProjectText}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="2,2,0,0" TextWrapping="Wrap"
                       Text="Read from the agents' own files; nothing is changed. Kovan's own hook and MCP server aren't listed."/>
        </StackPanel>

        <Grid>
            <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,40,0,0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
                <ItemsControl ItemsSource="{Binding Groups}" AutomationProperties.Name="Tools">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ToolGroup}">
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type services:ToolItem}">
                                                <DockPanel Margin="0,4" ToolTip="{Binding Location}">
                                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Top"
                                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                        <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </Border>
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.55"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,1,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Detail}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
