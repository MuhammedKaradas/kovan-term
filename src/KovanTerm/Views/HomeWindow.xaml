<ui:FluentWindow x:Class="KovanTerm.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KovanTerm.ViewModels"
        xmlns:mesh="clr-namespace:KovanTerm.Services.Mesh"
        xmlns:conv="clr-namespace:KovanTerm.Views.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
        Title="Home" Width="980" Height="780" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}"/>
        <KeyBinding Key="F5" Command="{Binding LoadStatsCommand}"/>
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NodeStatusToBrushConverter x:Key="StatusToBrush"/>
        <conv:PercentToFractionConverter x:Key="PercentToFraction"/>

        <!-- A tile: a rounded card with a faint sheen at the top -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- A clickable row -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="-8,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="AgentRow" DataType="{x:Type vm:TerminalNodeViewModel}">
            <Border Style="{StaticResource Row}" MouseLeftButtonUp="Agent_Click" AutomationProperties.Name="{Binding Title}" ToolTip="Go to this terminal">
                <DockPanel>
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding GroupName}" Style="{StaticResource Muted}" Margin="8,0,0,0" MaxWidth="140"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Home" ShowMinimize="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,14,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Needs you -->
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Needs you" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="Nobody's waiting for you." Style="{StaticResource Muted}"
                                   Visibility="{Binding NobodyWaits, Converter={StaticResource BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding NeedsYou}" ItemTemplate="{StaticResource AgentRow}" AutomationProperties.Name="Agents that need you"/>
                        <ItemsControl ItemsSource="{Binding Elsewhere}" AutomationProperties.Name="Sessions outside Kovan that need you">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OutsideSessionViewModel}">
                                    <Border Style="{StaticResource Row}" MouseLeftButtonUp="Elsewhere_Click" ToolTip="Outside Kovan: answer it in its own window">
                                        <DockPanel>
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="elsewhere" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- At work -->
                <Border Grid.Column="1" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="At work" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="No agent is working." Style="{StaticResource Muted}"
                                   Visibility="{Binding NothingAtWork, Converter={StaticResource BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding AtWork}" ItemTemplate="{StaticResource AgentRow}" AutomationProperties.Name="Agents at work"/>
                    </StackPanel>
                </Border>

                <!-- Today and this week -->
                <Border Grid.Row="1" Style="{StaticResource Tile}">
                    <StackPanel>
                        <DockPanel>
                            <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="16" Height="16"
                                             Visibility="{Binding IsLoadingStats, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="Your work" Style="{StaticResource TileTitle}"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Today" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Today.TimeText}" Style="{StaticResource BigNumber}" AutomationProperties.Name="Time today"/>
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="{Binding Today.TokensText, Mode=OneWay}"/><Run Text=" tokens · "/><Run Text="{Binding Today.SessionsText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="This week" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Week.TimeText}" Style="{StaticResource BigNumber}" AutomationProperties.Name="Time this week"/>
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="{Binding Week.TokensText, Mode=OneWay}"/><Run Text=" tokens · "/><Run Text="{Binding Week.SessionsText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Active time from Claude Code's and Codex's session files; Statistics has the rest (Ctrl+Shift+Y)."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Plan limits: the Agents panel's rows -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <StackPanel.Resources>
                            <DataTemplate DataType="{x:Type vm:UsageRow}">
                                <Grid Margin="0,4" ToolTip="{Binding ResetsAtText, StringFormat=Resets {0}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="HomeUsageLabel"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <Grid Height="6">
                                            <Rectangle Fill="{DynamicResource ControlStrokeColorDefaultBrush}" RadiusX="3" RadiusY="3"/>
                                            <Rectangle RadiusX="3" RadiusY="3" RenderTransformOrigin="0,0.5">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Percent, Converter={StaticResource PercentToFraction}}"/>
                                                </Rectangle.RenderTransform>
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Grid>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </StackPanel.Resources>
                        <TextBlock Text="Plan limits" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="Not known yet: they show after a Claude Code or Codex turn." TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Main.HasAnyUsage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Visibility="{Binding Main.HasUsage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Claude" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding Main.UsageRows}" AutomationProperties.Name="Claude plan usage"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Main.HasCodexUsage, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Main.CodexUsageTitle}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding Main.CodexUsageRows}" AutomationProperties.Name="Codex plan usage"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Pull requests of worktrees -->
                <Border Grid.Row="2" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Pull requests" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="No worktree has a pull request." Style="{StaticResource Muted}"
                                   Visibility="{Binding NoPullRequests, Converter={StaticResource BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding PullRequests}" AutomationProperties.Name="Pull requests">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PullRequestRow}">
                                    <Border Style="{StaticResource Row}" MouseLeftButtonUp="PullRequest_Click" ToolTip="Go to its terminal">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Branch}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The Board's open tasks -->
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Board" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="No open tasks. Add some on the Board (Ctrl+Shift+B)." Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding NoTasks, Converter={StaticResource BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding Tasks}" AutomationProperties.Name="Open tasks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type mesh:MeshTask}">
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Margin="8,0,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="State"/>
                                                    <Binding Path="OwnerName" TargetNullValue=""/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <Run Text="{Binding Id, StringFormat=#{0} , Mode=OneWay}"/><Run Text="{Binding Title, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
