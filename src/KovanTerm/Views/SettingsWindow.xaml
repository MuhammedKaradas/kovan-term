<ui:FluentWindow x:Class="KovanTerm.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KovanTerm.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Settings" Width="620" Height="680" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}"/>
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.Resources>
        <!-- A choice is read out by its label, not its record -->
        <Style x:Key="ChoiceItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="28,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </ui:FluentWindow.Resources>

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Settings" ShowMinimize="False" ShowMaximize="False"/>

        <TextBlock DockPanel.Dock="Bottom" Margin="24,8,24,16" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <Run Text="Changes are saved right away, to"/>
            <Hyperlink Click="OpenFile_Click" AutomationProperties.Name="Open settings file"><Run Text="{Binding FilePath, Mode=OneWay}"/></Hyperlink>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
            <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource Section}" Margin="0,4,0,6"/>
                <DockPanel>
                    <TextBlock Text="Theme" VerticalAlignment="Center" Width="140" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="200" HorizontalAlignment="Left"
                              AutomationProperties.Name="Theme"/>
                </DockPanel>

                <TextBlock Text="Agents" Style="{StaticResource Section}"/>
                <CheckBox Content="Name Claude Code terminals after their conversation" IsChecked="{Binding TitlesFromClaude}"
                          AutomationProperties.Name="Titles from Claude"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="A /rename always renames the terminal; Claude's own title only while you haven't named it (right-click its header → Rename)."/>
                <CheckBox Content="Keep the computer awake while an agent works" IsChecked="{Binding KeepAwakeWhileWorking}"
                          AutomationProperties.Name="Keep awake"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Windows doesn't go to sleep on its own until no agent is working. The screen can still turn off, and closing a laptop's lid still does what your power settings say."/>

                <TextBlock Text="Notifications" Style="{StaticResource Section}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="Shown only while Kovan isn't the active window; clicking one goes to that agent."/>
                <CheckBox Content="When an agent needs you (a permission, a question)" IsChecked="{Binding NotifyWhenWaiting}"
                          AutomationProperties.Name="Notify when waiting"/>
                <CheckBox Content="When an agent finishes its turn" IsChecked="{Binding NotifyWhenDone}" Margin="0,8,0,0"
                          AutomationProperties.Name="Notify when done"/>

                <TextBlock Text="Voice" Style="{StaticResource Section}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                           Text="Dictation (Ctrl+Shift+Space) and voice commands (Ctrl+Shift+K) turn speech into text on this computer, with Whisper."/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Speech model" VerticalAlignment="Center" Width="140" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox ItemsSource="{Binding Models}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding DictationModel}" ItemContainerStyle="{StaticResource ChoiceItem}"
                              MinWidth="260" HorizontalAlignment="Left" AutomationProperties.Name="Speech model"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="140,0,0,8"
                           Text="Downloaded once, the first time it's used. Larger is more accurate, slower and uses more memory."/>
                <DockPanel>
                    <TextBlock Text="Language" VerticalAlignment="Center" Width="140" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding DictationLanguage}" ItemContainerStyle="{StaticResource ChoiceItem}"
                              MinWidth="260" HorizontalAlignment="Left" AutomationProperties.Name="Language"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="140,4,0,8"
                           Text="Setting one language makes dictation faster and more accurate in it; voice commands in another language are then misheard."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
