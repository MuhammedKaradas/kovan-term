<ui:FluentWindow x:Class="KovanTerm.Views.NewTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KovanTerm.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:NewTerminalViewModel}"
        Title="New terminal" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FocusManager.FocusedElement="{Binding ElementName=ProfileList}">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </ui:FluentWindow.Resources>
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </ui:FluentWindow.InputBindings>

    <StackPanel>
        <ui:TitleBar Title="New terminal" ShowMinimize="False" ShowMaximize="False"/>

        <StackPanel Margin="16,4,16,16">
            <TextBlock Text="Profile" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ListBox x:Name="ProfileList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MaxHeight="300">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <!-- Double-click: select and open -->
                        <EventSetter Event="MouseDoubleClick" Handler="ProfileItem_DoubleClick"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfileOptionViewModel}">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Working directory" FontWeight="SemiBold" Margin="0,16,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Folder24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <ComboBox IsEditable="True" ItemsSource="{Binding RecentDirectories}"
                          Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>

            <!-- WSL: keep the program running in tmux after Kovan closes -->
            <CheckBox Margin="0,14,0,0" IsChecked="{Binding KeepRunning}" AutomationProperties.Name="Keep running when Kovan closes"
                      Visibility="{Binding IsWsl, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Keep running when Kovan closes" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Runs in a hidden tmux session inside the distro; the node attaches to it again next time."
                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </CheckBox>

            <!-- Worktree: only for folders inside a git repository -->
            <StackPanel Margin="0,14,0,0" Visibility="{Binding CanUseWorktree, Converter={StaticResource BoolToVisibility}}">
                <CheckBox IsChecked="{Binding UseWorktree}" AutomationProperties.Name="Start in a new git worktree">
                    <StackPanel>
                        <TextBlock Text="Start in a new git worktree" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Its own branch and folder, so parallel agents don't touch each other's files."
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </CheckBox>
                <StackPanel Margin="28,8,0,0" Visibility="{Binding UseWorktree, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Branch" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:TextBox Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Branch name"/>
                    <TextBlock Text="{Binding WorktreePathPreview}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" ToolTip="{Binding WorktreePathPreview}"/>
                    <TextBlock Text="Setup command (optional, remembered for this repository)" FontSize="12" Margin="0,10,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:TextBox Text="{Binding SetupCommand, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Setup command"
                                PlaceholderText="e.g. npm install &amp;&amp; copy &quot;%KOVAN_REPO%\.env&quot; ."
                                FontFamily="Cascadia Mono, Consolas"/>
                    <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Runs in the new worktree before the agent starts (cmd). %KOVAN_REPO% is the main checkout."/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Margin="0,10,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90"/>
                <ui:Button Content="Open" Appearance="Primary" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="90"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
