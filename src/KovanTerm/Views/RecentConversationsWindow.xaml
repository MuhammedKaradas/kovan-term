<ui:FluentWindow x:Class="KovanTerm.Views.RecentConversationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KovanTerm.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RecentConversationsViewModel}"
        Title="Recent conversations" Width="680" Height="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </ui:FluentWindow.InputBindings>

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Recent conversations" ShowMinimize="False" ShowMaximize="False"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10,16,16">
            <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90"/>
            <ui:Button Content="Open" Appearance="Primary" Command="{Binding OpenCommand}" IsDefault="True" MinWidth="90"/>
        </StackPanel>

        <ui:TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="16,4,16,8" PlaceholderText="Search titles and folders"
                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search conversations"
                    PreviewKeyDown="SearchBox_PreviewKeyDown"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyMessage}" Margin="16,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EmptyMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Margin="12,0,12,0"
                 AutomationProperties.Name="Conversations" VirtualizingPanel.IsVirtualizing="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                    <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ConversationRow}">
                    <DockPanel Margin="0,3">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       ToolTip="{Binding Folder}">
                                <Run Text="{Binding FolderName, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="  "/><Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </TextBlock>
                            <TextBlock Text="Already open on the canvas" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</ui:FluentWindow>
