<Window x:Class="KovanTerm.Views.StatusLightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kovan status" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Cursor="Hand">
    <!-- A small pill on the screen's edge: green while agents work, yellow while one waits for you.
         The colors are the node status dots'; the counts say the same thing without color. -->
    <!-- A button, so it can be invoked without a mouse (screen readers, UI Automation) -->
    <Button x:Name="PillButton" Click="Pill_Click" PreviewMouseLeftButtonDown="Pill_PreviewMouseLeftButtonDown"
            AutomationProperties.Name="Kovan status light" Focusable="False">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter/>
            </ControlTemplate>
        </Button.Template>
    <Border x:Name="Pill" CornerRadius="10" Padding="5,7" Background="#E61F1F1F" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Right edge" Click="RightEdge_Click"/>
                <MenuItem Header="Left edge" Click="LeftEdge_Click"/>
                <Separator/>
                <MenuItem Header="Turn off (Settings)" Click="TurnOff_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#F0EFEC"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,1,0,0"/>
                </Style>
            </StackPanel.Resources>
            <Ellipse x:Name="WorkingDot" Width="12" Height="12" Fill="LimeGreen"/>
            <TextBlock x:Name="WorkingText" AutomationProperties.Name="Agents working"/>
            <Ellipse x:Name="WaitingDot" Width="12" Height="12" Fill="Gold" Margin="0,6,0,0"/>
            <TextBlock x:Name="WaitingText" AutomationProperties.Name="Agents waiting"/>
        </StackPanel>
    </Border>
    </Button>
</Window>
