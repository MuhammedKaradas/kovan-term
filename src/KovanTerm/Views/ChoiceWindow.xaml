<ui:FluentWindow x:Class="KovanTerm.Views.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <StackPanel>
        <ui:TitleBar x:Name="TitleBarControl" ShowMinimize="False" ShowMaximize="False"/>
        <StackPanel Margin="20,4,20,20">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <!-- Buttons are added in code, the first one is the default -->
            <WrapPanel x:Name="Buttons" HorizontalAlignment="Right" Margin="0,20,0,0"/>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
