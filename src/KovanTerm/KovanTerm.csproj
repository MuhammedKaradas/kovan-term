<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>KovanTerm</AssemblyName>
    <Product>Kovan Term</Product>
    <Version>0.1.0</Version>
    <!-- Our own symbols are embedded in the dll: crash reports keep line numbers without shipping a separate .pdb -->
    <DebugType>embedded</DebugType>
    <!-- Crash reports are sent only by builds given an address (the release workflow sets it); empty: never asked or sent -->
    <KovanCrashReportEndpoint Condition="'$(KovanCrashReportEndpoint)' == ''"></KovanCrashReportEndpoint>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CrashReportEndpoint" Value="$(KovanCrashReportEndpoint)" />
  </ItemGroup>

  <!-- Don't publish .pdb files that come from packages (e.g. the 81 MB Microsoft.Terminal.Control.pdb) -->
  <Target Name="KovanExcludePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
      <!-- Whisper.net copies its native libraries for every Windows architecture; keep only the one being published -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'$(RuntimeIdentifier)' != '' and $([System.String]::Copy('%(RelativePath)').StartsWith('runtimes')) and !$([System.String]::Copy('%(RelativePath)').Contains('$(RuntimeIdentifier)'))" />
    </ItemGroup>
  </Target>

  <!-- The launcher for terminals whose profile sets environment variables, built next to KovanTerm.exe -->
  <ItemGroup>
    <ProjectReference Include="..\KovanLaunch\KovanLaunch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\screen-rules.json" LogicalName="KovanTerm.Resources.screen-rules.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="EasyWindowsTerminalControl" Version="1.0.38" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Nodify" Version="7.3.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
